# =====================================================
# LINE Issue Tracker — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# =====================================================

PORT=3000

# Line Messaging API
# ดูได้จาก https://developers.line.biz/console/ → เลือก Channel → Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_channel_long_lived_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# Supabase
# ดูได้จาก Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here    # ใช้เฉพาะ backend เท่านั้น
SUPABASE_ANON_KEY=your_anon_public_key_here        # ส่งให้ frontend สำหรับ realtime

# Google AI Studio API (สำหรับ Gemma auto-classify — ไม่บังคับ)
# ดูได้จาก https://aistudio.google.com/ → Get API key
GOOGLE_AI_API_KEY=AIza...
# เปลี่ยน model ได้ (default: gemma-4-27b-it)
# GEMMA_MODEL=gemma-3-27b-it
